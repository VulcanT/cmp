# Mode: dry_run (default) never calls Apple write endpoints; live does.
CMP_MODE=dry_run
CMP_DATABASE_URL=postgresql+psycopg://cmp:cmp@localhost:5432/cmp
CMP_TIMEZONE=Australia/Sydney
CMP_RUN_AT=10:00

# AppsFlyer API V2 token (admin > API tokens)
AF_API_TOKEN=

# Apple Ads Platform API (Account Settings > API after uploading public key)
ASA_CLIENT_ID=SEARCHADS.xxxx
ASA_TEAM_ID=SEARCHADS.xxxx
ASA_KEY_ID=
ASA_PRIVATE_KEY_PATH=secrets/private-key.pem
